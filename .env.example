APP_NAME="FieldTrack Sales Tracking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Business timezone. Work dates are stored for this zone while all timestamps
# are stored in UTC.
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL is the production database. The development machines in this project
# run MySQL 8 on port 3310; use 3306 for a default local install.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sales_tracking
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Photos are stored on the local filesystem (private disk) and never leave
# the server except through the authorized download endpoints.
FILESYSTEM_DISK=local

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Tracking and distance calculation
# -----------------------------------------------------------------------------

# Master switch for GPS ingestion endpoints.
TRACKING_ENABLED=true

# Server-side GPS quality filters (defence in depth; the app filters too).
LOCATION_MAX_ACCEPTED_ACCURACY_METERS=50
DISTANCE_MIN_SEGMENT_METERS=8
LOCATION_MAX_SPEED_KMH=180
LOCATION_GAP_WARNING_MINUTES=10

# Oldest device-recorded event the API accepts during synchronization.
# Attendance start/end, tracking batches and visits share this window.
LOCATION_HISTORY_MAX_DAYS=30

# Maximum points accepted in one batch upload.
TRACKING_BATCH_MAX_POINTS=500

# A live position is reported as "stale" after this many minutes without an
# accepted point.
TRACKING_STALE_AFTER_MINUTES=10

# -----------------------------------------------------------------------------
# Retention policies
# -----------------------------------------------------------------------------

# Raw GPS points are pruned after this many days; attendance summaries,
# distances and visit records are kept.
GPS_RETENTION_DAYS=180
PHOTO_RETENTION_DAYS=365
ENABLE_GPS_ARCHIVAL=true

# -----------------------------------------------------------------------------
# Photo uploads (multipart, private storage — never stored in MySQL)
# -----------------------------------------------------------------------------

PHOTO_MAX_UPLOAD_MB=8
PHOTO_MAX_WIDTH=1600
PHOTO_JPEG_QUALITY=82
PHOTO_THUMBNAIL_WIDTH=320
PHOTO_MAX_PIXELS=24000000

# -----------------------------------------------------------------------------
# Firebase Cloud Messaging — optional and disabled by default.
# The whole application works without Firebase; leave FIREBASE_ENABLED=false
# until a real project and service-account credentials are available.
#
# To activate:
#   1. Firebase Console -> Project settings -> Service accounts ->
#      "Generate new private key" (keep the JSON OUTSIDE version control).
#   2. Store it somewhere private, e.g. storage/app/firebase/service-account.json
#      (storage/app is git-ignored), and point FIREBASE_CREDENTIALS at it —
#      an absolute path, or the raw JSON string itself.
#   3. Set FIREBASE_ENABLED=true and FIREBASE_PROJECT_ID to the Firebase
#      project id of your app (the same one as lib/firebase_options.dart).
# -----------------------------------------------------------------------------
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=
FIREBASE_DATABASE_URL=
